    },
    {
      "$comment": "MA-5.6 — a signature construction carries the signature, the key that made it and the fields it covers. Without the field list the signature attests an unstated subset of the record.",
      "if": {
        "properties": {
          "integrity": {
            "properties": {
              "mechanism": {
