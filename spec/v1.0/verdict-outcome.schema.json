        }
      }
    },
    {
      "$comment": "MA-7.7 — an advisory recommends a mechanism, and the same compatibility holds for a recommendation as for a performed directive. Permitted under `attenuate`: attenuate, redact, rate_limit.",
      "if": {
        "properties": {
          "decision_outcome": {
            "const": "attenuate"
