    {
      "$comment": "MA-7.7 — an advisory recommends a mechanism, and the same compatibility holds for a recommendation as for a performed directive. Permitted under `escalate`: escalate, defer.",
      "if": {
        "properties": {
          "decision_outcome": {
            "const": "escalate"
