        },
        "required": [
          "intervention"
        ]
      },
      "then": {
        "properties": {
          "intervention": {
            "required": [
              "parameters"
            ]
          }
        }
      }
    },
    {
      "$comment": "MA-3.11 — a non_measurement_cause states why no measurement was taken, so it belongs only to a record that took none. On any other status it says both that a measurement happened and why none did.",
      "if": {
        "required": [
          "non_measurement_cause"
        ]
      },
      "then": {
        "properties": {
          "measurement_status": {
            "const": "NOT_MEASURED"
          }
        }
      }
    },
    {
      "$comment": "MA-7.7 — `block` names the class of effect; intervention.type names the mechanism performing it. Permitted: block.",
      "if": {
        "properties": {
          "decision_outcome": {
            "const": "block"
          }
        },
        "required": [
          "decision_outcome",
          "intervention"
        ]
      },
      "then": {
        "properties": {
          "intervention": {
            "properties": {
              "type": {
                "enum": [
                  "block"
                ]
              }
            }
          }
