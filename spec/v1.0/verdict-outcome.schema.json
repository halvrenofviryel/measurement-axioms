                  }
                },
                "not": {
                  "required": [
                    "previous_digest"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "$comment": "MA-3.8 — a cause of input_absent or input_unreadable says the required input could not be obtained for measurement. A record carrying inputs_present: true alongside it states both that it could and that it could not.",
      "if": {
        "properties": {
          "non_measurement_cause": {
