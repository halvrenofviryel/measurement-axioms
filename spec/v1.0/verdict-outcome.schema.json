      "then": {
        "properties": {
          "measurement_status": {
            "const": "NOT_MEASURED"
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "pattern": "^sha384:[0-9a-f]{96}$"
        },
        {
          "pattern": "^sha512:[0-9a-f]{128}$"
        },
        {
          "pattern": "^blake2b:[0-9a-f]{128}$"
        },
        {
          "pattern": "^blake3:[0-9a-f]{64}$"
        }
      ],
      "description": "An algorithm-prefixed lowercase hex digest whose length matches the algorithm named. A single length range across algorithms accepts sha256 at 128 characters and sha512 at 64 — values no implementation produces, which a reader cannot recompute.",
      "minLength": 1
    }
  }
}
