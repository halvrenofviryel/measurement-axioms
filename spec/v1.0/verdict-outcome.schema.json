            ]
          }
        },
        "required": [
          "integrity"
        ]
      },
      "then": {
        "properties": {
          "integrity": {
            "required": [
              "timestamp_token_ref",
              "timestamp_authority_ref"
            ]
          }
        }
      }
    },
    {
      "$comment": "MA-5.6 — a record naming witnessed_ledger as its integrity construction carries that construction's artefact. Naming a mechanism and omitting what makes it one is the same empty claim as an evidence level with no basis at all.",
      "if": {
        "properties": {
