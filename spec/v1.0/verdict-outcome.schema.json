            "properties": {
              "inputs_present": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "$comment": "MA-3.8 — an absent or unreadable required input yields NOT_MEASURED. The earlier rule forbade only PASS, so FAIL, INCONCLUSIVE and ERROR could each report a result reached from an input the record says could not be obtained.",
      "if": {
        "properties": {
          "measured": {
            "type": "object",
            "properties": {
              "inputs_present": {
                "const": false
              }
            },
            "required": [
              "inputs_present"
            ]
          }
        },
        "required": [
          "measured"
        ]
