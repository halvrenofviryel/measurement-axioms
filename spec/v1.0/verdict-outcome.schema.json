          }
        }
      }
    },
    {
      "$comment": "MA-7.7 — `abstain` names the class of effect; intervention.type names the mechanism performing it. Permitted: defer.",
      "if": {
        "properties": {
          "decision_outcome": {
            "const": "abstain"
          }
        },
        "required": [
          "decision_outcome",
          "intervention"
        ]
