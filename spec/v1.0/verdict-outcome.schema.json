                {
                  "required": [
                    "inputs_present"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "$comment": "MA-5.6 — a record naming external_timestamp as its integrity construction carries that construction's artefact. Naming a mechanism and omitting what makes it one is the same empty claim as an evidence level with no basis at all.",
      "if": {
        "properties": {
          "integrity": {
            "properties": {
              "mechanism": {
                "enum": [
                  "external_timestamp"
