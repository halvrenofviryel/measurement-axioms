                "enum": [
                  "defer"
                ]
              }
            }
          }
        }
      }
    },
    {
      "$comment": "MA-7.7 — `allow` decided against intervening, so it carries no intervention record. One here would name an effect the decision did not call for.",
      "if": {
        "properties": {
          "decision_outcome": {
            "const": "allow"
          }
        },
        "required": [
          "decision_outcome"
        ]
      },
      "then": {
        "not": {
          "required": [
            "intervention"
          ]
        }
      }
    },
    {
      "$comment": "MA-3.3 — a scope_decision says why an object was not assessed, so it belongs only to NOT_APPLICABLE. Elsewhere it states both that the object was assessed and that it was out of scope.",
      "if": {
        "required": [
          "scope_decision"
        ]
      },
      "then": {
        "properties": {
          "measurement_status": {
            "const": "NOT_APPLICABLE"
          }
        }
      }
    },
    {
      "$comment": "MA-3.3 — an out-of-scope object was not examined, so there is no count of examined items and no input state to report.",
      "if": {
        "properties": {
          "measurement_status": {
            "const": "NOT_APPLICABLE"
          }
        },
        "required": [
          "measurement_status"
        ]
      },
      "then": {
        "properties": {
          "measured": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "items_checked"
